# ==============================================================================
# CraftCV Server Environment Configuration (.env.example)
# Copy this file to .env in the server/ directory for local development.
# IMPORTANT: Never commit actual secret keys or production credentials to Git.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# MongoDB connection URI. If MongoDB is offline, server will automatically activate in-memory fallback.
MONGO_URI=mongodb://127.0.0.1:27017/craftcv

# Security & Authentication
# Secret key for JWT signing. Replace with a high-entropy string in production.
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars

# External Integrations (Optional)
# Google Gemini API key for AI resume suggestions and interview prep
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token to avoid public rate-limiting during GitHub profile ingestion
GITHUB_TOKEN=your_github_personal_access_token_here
