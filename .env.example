# ==============================================================================
# CraftCV Environment Configuration Template (.env.example)
# Copy to .env and configure for local development. Never commit real secrets.
# ==============================================================================

# Web & API Ports
PORT=5000
VITE_API_URL=http://localhost:5000/api

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/craftcv
DATABASE_URL=mongodb://127.0.0.1:27017/craftcv

# Authentication Secret
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars

# External API Integrations (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GITHUB_TOKEN=your_github_personal_access_token_here
